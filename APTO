<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#173f35"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-status-bar-style" content="default"><meta name="apple-mobile-web-app-title" content="APTO Gestión"><link rel="manifest" href="manifest.json"><link rel="apple-touch-icon" href="icon-192.png"><title>APTO | Mi gestión</title>
<style>
:root{--green:#173f35;--mint:#e9f1ed;--ink:#1c2924;--muted:#69766f;--line:#e2e8e4;--bg:#f5f7f5;--white:#fff;--red:#b33b36;--amber:#a66a16}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;padding-bottom:90px}.top{background:var(--green);color:white;padding:calc(18px + env(safe-area-inset-top)) 18px 22px}.top small{opacity:.8}.top h1{margin:5px 0 0;font-size:24px}.wrap{max-width:760px;margin:auto;padding:16px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.stat,.panel,.task{background:white;border:1px solid var(--line);border-radius:16px;padding:14px}.stat b{font-size:25px;display:block}.stat span,.muted{font-size:13px;color:var(--muted)}.sectionhead{display:flex;align-items:center;justify-content:space-between;margin:22px 0 10px}.sectionhead h2{font-size:18px;margin:0}.btn{border:0;border-radius:12px;background:var(--green);color:white;padding:12px 15px;font-weight:650;font-size:14px}.btn.secondary{background:var(--mint);color:var(--green)}.btn.danger{background:#f8e9e8;color:var(--red)}.task{margin:9px 0}.tasktop{display:flex;justify-content:space-between;gap:10px}.task h3{font-size:16px;margin:0 0 6px}.tag{font-size:11px;border-radius:20px;padding:5px 8px;background:var(--mint);color:var(--green);white-space:nowrap;height:max-content}.meta{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:12px;margin-top:10px}.actions{display:flex;gap:7px;margin-top:12px}.actions button{padding:8px 11px}.nav{position:fixed;bottom:0;left:0;right:0;background:#ffffffed;border-top:1px solid var(--line);display:flex;justify-content:space-around;padding:9px 6px calc(9px + env(safe-area-inset-bottom));backdrop-filter:blur(12px)}.nav button{border:0;background:none;color:var(--muted);font-size:12px;padding:5px}.nav button.active{color:var(--green);font-weight:700}.nav span{display:block;font-size:20px;margin-bottom:3px}input,select,textarea{width:100%;border:1px solid var(--line);border-radius:10px;padding:12px;font:inherit;background:white;color:var(--ink)}label{display:block;font-size:13px;font-weight:650;margin:12px 0 6px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.formgrid .full{grid-column:1/-1}.hidden{display:none!important}.empty{text-align:center;padding:28px 12px;color:var(--muted)}.toolbar{display:flex;gap:8px;flex-wrap:wrap}.toolbar input{flex:1;min-width:150px}.footnote{font-size:12px;color:var(--muted);line-height:1.45;margin-top:16px}dialog{border:0;border-radius:18px;padding:0;width:min(94%,560px);max-height:90vh;box-shadow:0 15px 50px #0003}dialog::backdrop{background:#10251fcc}.modal{padding:18px;overflow:auto;max-height:90vh}.modalhead{display:flex;justify-content:space-between;align-items:center}.modalhead h2{margin:0;font-size:20px}.close{border:0;background:var(--bg);border-radius:50%;width:34px;height:34px;font-size:20px}.due{color:var(--red);font-weight:650}.priority-Urgente{background:#f9e5e3;color:#a52c27}.priority-Alta{background:#fff0db;color:#94590c}.priority-Media{background:#edf0df;color:#5b681f}.priority-Baja{background:#e9eff5;color:#405b75}
</style></head><body>
<header class="top"><small>ASOCIACIÓN APTO · USO PERSONAL</small><h1>APTO | Mi gestión</h1><div class="muted" style="color:#d6e4de;margin-top:5px">Tus tareas, proyectos y prioridades en un solo lugar</div></header>
<main class="wrap"><section id="dashboard"><div class="stats" id="stats"></div><div class="sectionhead"><h2>Próximos vencimientos</h2><button class="btn" onclick="openTask()">＋ Nueva tarea</button></div><div id="upcoming"></div></section>
<section id="tasks" class="hidden"><div class="sectionhead"><h2>Mis tareas</h2><button class="btn" onclick="openTask()">＋ Nueva tarea</button></div><div class="toolbar"><input id="search" placeholder="Buscar tareas…" oninput="renderTasks()"><select id="filterState" onchange="renderTasks()"><option value="">Todos los estados</option><option>Pendiente</option><option>En curso</option><option>Bloqueada</option><option>Delegada</option><option>Completada</option></select></div><div id="tasklist"></div></section>
<section id="projects" class="hidden"><div class="sectionhead"><h2>Proyectos</h2></div><div class="panel"><label for="newProject">Añadir proyecto</label><div class="toolbar"><input id="newProject" placeholder="Nombre del proyecto"><button class="btn" onclick="addProject()">Añadir</button></div></div><div id="projectlist"></div></section>
<section id="backup" class="hidden"><div class="sectionhead"><h2>Copias de seguridad</h2></div><div class="panel"><p>Las tareas se guardan en este navegador y dispositivo. Exporta una copia periódicamente para no perderlas si cambias de móvil o borras los datos de Safari.</p><div class="toolbar"><button class="btn" onclick="exportData()">Exportar copia</button><label class="btn secondary" style="margin:0;cursor:pointer">Importar copia<input type="file" accept="application/json" onchange="importData(event)" hidden></label></div><p class="footnote">Esta primera versión no sincroniza automáticamente con otros dispositivos. Guarda los archivos adjuntos importantes en un lugar seguro; esta versión no almacena adjuntos.</p></div></section></main>
<nav class="nav"><button class="active" data-page="dashboard" onclick="showPage('dashboard',this)"><span>⌂</span>Inicio</button><button data-page="tasks" onclick="showPage('tasks',this)"><span>☷</span>Tareas</button><button data-page="projects" onclick="showPage('projects',this)"><span>▦</span>Proyectos</button><button data-page="backup" onclick="showPage('backup',this)"><span>⇧</span>Copia</button></nav>
<dialog id="taskDialog"><form class="modal" id="taskForm" onsubmit="saveTask(event)"><div class="modalhead"><h2 id="formTitle">Nueva tarea</h2><button type="button" class="close" onclick="taskDialog.close()">×</button></div><input type="hidden" id="taskId"><label for="title">Tarea *</label><input id="title" required maxlength="140" placeholder="¿Qué necesitas hacer?"><div class="formgrid"><div><label for="area">Área</label><select id="area"><option>Dirección y estrategia</option><option>Personal y recursos humanos</option><option>Centro y atención a personas</option><option>Centro Especial de Empleo</option><option>Proyectos y subvenciones</option><option>Administración y finanzas</option><option>Calidad y cumplimiento normativo</option><option>Comunicación y relaciones institucionales</option><option>Formación y prevención</option><option>Otros</option></select></div><div><label for="priority">Prioridad</label><select id="priority"><option>Urgente</option><option>Alta</option><option selected>Media</option><option>Baja</option></select></div><div><label for="state">Estado</label><select id="state"><option>Pendiente</option><option>En curso</option><option>Bloqueada</option><option>Delegada</option><option>Completada</option></select></div><div><label for="due">Fecha límite</label><input id="due" type="date"></div><div class="full"><label for="project">Proyecto</label><select id="project"><option value="">Sin proyecto</option></select></div><div class="full"><label for="next">Siguiente acción / notas</label><textarea id="next" rows="3" placeholder="Anota el siguiente paso o información útil"></textarea></div></div><div class="toolbar" style="margin-top:18px"><button class="btn" type="submit">Guardar tarea</button><button class="btn secondary" type="button" onclick="taskDialog.close()">Cancelar</button></div></form></dialog>
<script>
const KEY='apto_mi_gestion_v1';let data=load();function load(){try{return JSON.parse(localStorage.getItem(KEY))||{tasks:[],projects:[]}}catch{return{tasks:[],projects:[]}}}function persist(){localStorage.setItem(KEY,JSON.stringify(data))}function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function showPage(id,btn){document.querySelectorAll('main section').forEach(x=>x.classList.add('hidden'));document.getElementById(id).classList.remove('hidden');document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));btn.classList.add('active');render()}function render(){renderStats();renderUpcoming();renderTasks();renderProjects()}function renderStats(){let t=data.tasks;let items=[['Pendientes',t.filter(x=>x.state==='Pendiente').length],['En curso',t.filter(x=>x.state==='En curso').length],['Urgentes',t.filter(x=>x.priority==='Urgente'&&x.state!=='Completada').length],['Vencidas',t.filter(x=>x.due&&x.due<today()&&x.state!=='Completada').length]];stats.innerHTML=items.map(x=>`<div class="stat"><b>${x[1]}</b><span>${x[0]}</span></div>`).join('')}function today(){return new Date().toISOString().slice(0,10)}function taskCard(t){return `<article class="task"><div class="tasktop"><div><h3>${esc(t.title)}</h3><div class="muted">${esc(t.area||'Sin área')}</div></div><span class="tag priority-${esc(t.priority)}">${esc(t.priority)}</span></div><div class="meta"><span>${esc(t.state)}</span>${t.due?`<span class="${t.due<today()&&t.state!=='Completada'?'due':''}">Vence: ${new Date(t.due+'T12:00:00').toLocaleDateString('es-ES')}</span>`:''}${t.project?`<span>${esc(t.project)}</span>`:''}</div>${t.next?`<p class="muted">${esc(t.next)}</p>`:''}<div class="actions"><button class="btn secondary" onclick="openTask('${t.id}')">Editar</button><button class="btn secondary" onclick="toggleDone('${t.id}')">${t.state==='Completada'?'Reabrir':'Completar'}</button><button class="btn danger" onclick="deleteTask('${t.id}')">Eliminar</button></div></article>`}function renderUpcoming(){let list=data.tasks.filter(t=>t.due&&t.state!=='Completada').sort((a,b)=>a.due.localeCompare(b.due)).slice(0,5);upcoming.innerHTML=list.length?list.map(taskCard).join(''):'<div class="panel empty">No tienes tareas próximas. ¡Buen trabajo!</div>'}function renderTasks(){if(!tasklist)return;let q=(search?.value||'').toLowerCase(),f=filterState?.value||'';let list=data.tasks.filter(t=>(!q||(t.title+' '+t.area+' '+t.next+' '+t.project).toLowerCase().includes(q))&&(!f||t.state===f)).sort((a,b)=>(a.due||'9999').localeCompare(b.due||'9999'));tasklist.innerHTML=list.length?list.map(taskCard).join(''):'<div class="panel empty">No hay tareas que mostrar.</div>'}function renderProjects(){projectlist.innerHTML=data.projects.length?data.projects.map(p=>`<div class="task"><div class="tasktop"><b>${esc(p)}</b><button class="btn danger" onclick="removeProject('${encodeURIComponent(p)}')">Eliminar</button></div><div class="muted">${data.tasks.filter(t=>t.project===p).length} tareas asociadas</div></div>`).join(''):'<div class="panel empty">Todavía no has creado proyectos.</div>';project.innerHTML='<option value="">Sin proyecto</option>'+data.projects.map(p=>`<option>${esc(p)}</option>`).join('')}function openTask(id){taskForm.reset();taskId.value='';formTitle.textContent=id?'Editar tarea':'Nueva tarea';let t=data.tasks.find(x=>x.id===id);if(t){taskId.value=t.id;title.value=t.title;area.value=t.area;priority.value=t.priority;state.value=t.state;due.value=t.due||'';project.value=t.project||'';next.value=t.next||''}taskDialog.showModal()}function saveTask(e){e.preventDefault();let id=taskId.value;let old=data.tasks.find(x=>x.id===id);let t={id:id||crypto.randomUUID(),title:title.value.trim(),area:area.value,priority:priority.value,state:state.value,due:due.value,project:project.value,next:next.value.trim(),created:old?.created||new Date().toISOString()};if(old)data.tasks=data.tasks.map(x=>x.id===id?t:x);else data.tasks.push(t);persist();taskDialog.close();render()}function toggleDone(id){let t=data.tasks.find(x=>x.id===id);t.state=t.state==='Completada'?'Pendiente':'Completada';persist();render()}function deleteTask(id){if(confirm('¿Eliminar esta tarea?')){data.tasks=data.tasks.filter(x=>x.id!==id);persist();render()}}function addProject(){let p=newProject.value.trim();if(p&&!data.projects.includes(p)){data.projects.push(p);newProject.value='';persist();renderProjects()}}function removeProject(p){p=decodeURIComponent(p);if(confirm('¿Eliminar el proyecto? Las tareas asociadas no se borrarán.')){data.projects=data.projects.filter(x=>x!==p);data.tasks.forEach(t=>{if(t.project===p)t.project=''});persist();render()}}function exportData(){let blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='APTO-Mi-gestion-copia-'+today()+'.json';a.click();URL.revokeObjectURL(a.href)}function importData(e){let f=e.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let d=JSON.parse(r.result);if(!Array.isArray(d.tasks)||!Array.isArray(d.projects))throw 0;if(confirm('La importación sustituirá los datos actuales. ¿Continuar?')){data=d;persist();render();alert('Copia restaurada correctamente.')}}catch{alert('El archivo no parece una copia válida de APTO | Mi gestión.')}};r.readAsText(f)}render();if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}));
</script></body></html>

